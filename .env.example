# Copy to .env and fill in. Never commit .env.

# --- Meko (the product's own key, NOT your coding-agent key) ---
# Portal: https://cloud.mekodata.ai -> Settings -> API Keys -> name it "sunwai-app"
MEKO_API_KEY=mko_tkn_replace_me
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
# on | off  -- "off" runs the same flows with no Meko recall or writes (for the on/off comparison)
MEKO_ENABLED=on
# prefix for the product's datapacks (sunwai-desk, sunwai-hostel, ...)
MEKO_DATAPACK_PREFIX=sunwai-

# --- LLM (any OpenAI-compatible server: Ollama, vLLM, llama.cpp, hosted) ---
LLM_BASE_URL=http://localhost:11434/v1
# qwen3:4b-instruct on a 4 GB GPU; the plain qwen3:4b tag is now a thinking-only build (~87 s per triage)
LLM_MODEL=qwen3:4b-instruct
LLM_API_KEY=ollama
# requests sent to the model at once; the rest wait in the app (local GPUs serve 1-2 at a time)
LLM_PARALLEL=2

# --- App ---
SUNWAI_HOST=127.0.0.1
SUNWAI_PORT=8765
SUNWAI_DB=data/sunwai.db

# Salt for student pseudonyms (S-xxxx). Empty in dev; set a secret value in a real deployment (D-030).
SUNWAI_ID_SALT=
